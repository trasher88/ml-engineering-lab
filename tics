[32m+[m[32m                     "token_overlap": {"base": b, "lora": l}, "diagnostic_flags": {"base": bf, "lora": lf},[m
[32m+[m[32m                     "human_review": human})[m
[32m+[m[32m    def mean(values: list[float | int]) -> float | None:[m
