[32m+[m[32m    D --> H["Rubric score validation"][m
[32m+[m[32m    H --> I{"reviewer_id и полное покрытие?"}[m
[32m+[m[32m    I -->|Нет| J["Expert PARTIAL / NOT RATED"][m
