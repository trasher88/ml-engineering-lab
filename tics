[32m+[m[32m    L --> M["--check: повторный расчёт и byte equality"][m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m**Граница ответственности:** F4.3 отвечает за фиксированные критерии, F4.7 — за сохранённые тексты двух моделей, F5.2 — за чтение, лексические proxy, технические сигналы и прозрачный учёт выставленных человеком оценок. Файлы F5.1/F4 не редактируются.[m
[32m+[m
[32m+[m[32m## 6. Локальная проверка PowerShell[m
[32m+[m
[32m+[m[32mВсе команды выполняются из корня `F:\DEVELOPMENT\ML\ml-engineering-lab` после распаковки ZIP. В стандартном запуске **не нужны** Transformers, PEFT, GPU и доступ в интернет.[m
[32m+[m
[32m+[m[32m```powershell[m
[32m+[m[32mcd F:\DEVELOPMENT\ML\ml-engineering-lab[m
[32m+[m
[32m+[m[32m# Проверить контракт F5.2 без загрузки модели:[m
