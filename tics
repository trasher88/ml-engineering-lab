[32m+[m[32m        "source": {"path": source, "sha256": fingerprint, "format": Path(source).suffix.lstrip(".")},[m
[32m+[m[32m        "protocol": {"expected_cases": expected, "facts_per_case": required_facts,[m
[32m+[m[32m                     "tokenizer": "unicode_word_or_punctuation_casefold_v1", "overlap": "multiset_precision_recall_f1",[m
[32m+[m[32m                     "low_overlap_f1_threshold": threshold, "expert_scale": "0_incorrect_1_partial_2_correct",[m
[32m+[m[32m                     "human_provenance_rule": "requires_explicit_reviewer_id"},[m
[32m+[m[32m        "summary": {"cases": len(cases), "criteria_total": len(cases) * required_facts,[m
[32m+[m[32m                    "changed_pairs": changed, "unchanged_pairs": len(cases) - changed,[m
