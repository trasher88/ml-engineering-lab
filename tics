[32m+[m
[32m+[m[32mДля просмотра фактического расположения файлов F4.7 без изменения данных:[m
[32m+[m
[32m+[m[32m```powershell[m
[32m+[m[32mGet-ChildItem -Path data, reports -Recurse -File -ErrorAction SilentlyContinue |[m
[32m+[m[32m  Where-Object { $_.Name -match 'human_review|f4_07' } |[m
[32m+[m[32m  Select-Object -ExpandProperty FullName[m
[32m+[m[32m```[m
[32m+[m
