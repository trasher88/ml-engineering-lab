[32m+[m[32mdef _fact_scores(raw: Any, facts: tuple[str, ...], case_id: str) -> list[int] | None:[m
[32m+[m[32m    if raw is None:[m
[32m+[m[32m        return None[m
[32m+[m[32m    if isinstance(raw, dict):[m
[32m+[m[32m        if set(raw) != set(facts):[m
[32m+[m[32m            raise DiagnosticsError(f"{case_id}: неверные id в fact_scores")[m
[32m+[m[32m        raw = [raw[fid] for fid in facts][m
[32m+[m[32m    if not isinstance(raw, list) or len(raw) != len(facts):[m
[32m+[m[32m        raise DiagnosticsError(f"{case_id}: fact_scores должен содержать значения для всех критериев")[m
[32m+[m[32m    for value in raw:[m
[32m+[m[32m        if value is not None and (type(value) is not int or value not in {0, 1, 2}):[m
[32m+[m[32m            raise DiagnosticsError(f"{case_id}: оценки допустимы только 0/1/2/null")[m
[32m+[m[32m    return raw[m
