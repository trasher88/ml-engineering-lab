[32m+[m[32mdef _flags(case: Case, answer: str, score: dict[str, Any], threshold: float) -> list[str]:[m
[32m+[m[32m    flags: list[str] = [][m
[32m+[m[32m    if not answer.strip():[m
[32m+[m[32m        flags.append("empty_response")[m
[32m+[m[32m    if score["f1"] < threshold:[m
[32m+[m[32m        flags.append("low_reference_overlap")[m
[32m+[m[32m    if _MARKERS.search(answer):[m
[32m+[m[32m        flags.append("prompt_template_marker")[m
[32m+[m[32m    question_tokens = tokenize(case.question)[m
