[32m+[m[32m    if len(question_tokens) >= 5:[m
[32m+[m[32m        q = tuple(question_tokens[: min(8, len(question_tokens))])[m
[32m+[m[32m        if any(answer_tokens[i:i + len(q)] == q for i in range(len(answer_tokens) - len(q) + 1)):[m
[32m+[m[32m            flags.append("possible_prompt_echo")[m
