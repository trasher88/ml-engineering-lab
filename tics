[32m+[m[32mdef _parse_md(text: str) -> list[dict[str, Any]]:[m
[32m+[m[32m    """Разобрать экспорт human_review.md из F4.7; не оценивать факты автоматически."""[m
[32m+[m[32m    headers = list(_HEADER.finditer(text))[m
[32m+[m[32m    if not headers:[m
