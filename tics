[32m+[m[32m                                     "unreviewed_cases": unreviewed,[m
[32m+[m[32m                                     "unattributed_scores_ignored": unattributed,[m
[32m+[m[32m                                     "base_criteria_scored": len(human_values["base"]),[m
[32m+[m[32m                                     "lora_criteria_scored": len(human_values["lora"]),[m
[32m+[m[32m                                     "base_average_score": mean(human_values["base"]),[m
[32m+[m[32m                                     "lora_average_score": mean(human_values["lora"])}},[m
