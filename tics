[32m+[m[32mdef overlap(reference: str, candidate: str) -> dict[str, Any]:[m
[32m+[m[32m    """Multiset overlap: слова с повторами учитываются через Counter."""[m
[32m+[m[32m    a, b = tokenize(reference), tokenize(candidate)[m
[32m+[m[32m    matches = sum((Counter(a) & Counter(b)).values())[m
[32m+[m[32m    precision = matches / len(b) if b else 0.0[m
[32m+[m[32m    recall = matches / len(a) if a else 0.0[m
[32m+[m[32m    f1 = 2 * precision * recall / (precision + recall) if precision + recall else 0.0[m
[32m+[m[32m    return {"precision": precision, "recall": recall, "f1": f1, "exact_match": a == b,[m
[32m+[m[32m            "reference_token_count": len(a), "candidate_token_count": len(b)}[m
[32m+[m
[32m+[m
[32m+[m[32mdef _repetition(tokens: tuple[str, ...]) -> bool:[m
[32m+[m[32m    if len(tokens) < 12:[m
[32m+[m[32m        return False[m
[32m+[m[32m    grams = Counter(tuple(tokens[i:i + 4]) for i in range(len(tokens) - 3))[m
[32m+[m[32m    return max(grams.values(), default=0) >= 3[m
