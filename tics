[32m+[m[32mdef tokenize(text: str) -> tuple[str, ...]:[m
[32m+[m[32m    """Unicode токены: слова и одиночные знаки пунктуации, casefold."""[m
[32m+[m[32m    return tuple(_TOKEN.findall(text.casefold()))[m
