[32m+[m[32m    items = [][m
[32m+[m[32m    for idx, match in enumerate(headers):[m
[32m+[m[32m        chunk = text[match.end():headers[idx + 1].start() if idx + 1 < len(headers) else len(text)][m
[32m+[m[32m        sections = list(_SECTION.finditer(chunk))[m
[32m+[m[32m        found: dict[str, str] = {}[m
[32m+[m[32m        for j, section in enumerate(sections):[m
[32m+[m[32m            name = section.group(1)[m
[32m+[m[32m            if name in found:[m
[32m+[m[32m                raise DiagnosticsError(f"{match.group(1)}: дублирован раздел {name}")[m
[32m+[m[32m            value = chunk[section.end():sections[j + 1].start() if j + 1 < len(sections) else len(chunk)][m
[32m+[m[32m            # Разделитель между случаями не является содержимым ответа.[m
[32m+[m[32m            found[name] = re.sub(r"\n\s*---\s*$", "", value).strip()[m
[32m+[m[32m        if not all(k in found for k in _EXPECTED_KEYS):[m
[32m+[m[32m            raise DiagnosticsError(f"{match.group(1)}: отсутствуют секции human_review.md")[m
[32m+[m[32m        facts = [][m
[32m+[m[32m        for line in found["Факты для проверки"].splitlines():[m
[32m+[m[32m            f = _FACT.match(line.strip())[m
[32m+[m[32m            if not f:[m
[32m+[m[32m                raise DiagnosticsError(f"{match.group(1)}: неправильная строка факта")[m
[32m+[m[32m            facts.append({"id": f.group(1), "description": f.group(2)})[m
[32m+[m[32m        items.append({"case_id": match.group(1), "domain": match.group(2), "question": found["Вопрос"],[m
[32m+[m[32m                      "reference": found["Эталон"], "base_response": found["Base"],[m
[32m+[m[32m                      "lora_response": found["LoRA"], "facts": facts})[m
[32m+[m[32m    return items[m
